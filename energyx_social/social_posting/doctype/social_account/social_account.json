   "reqd": 1,
   "in_list_view": 1,
   "columns": 2
  },
  {
   "fieldname": "account_name",
   "fieldtype": "Data",
   "label": "Account Name",
   "reqd": 1,
   "in_list_view": 1,
   "columns": 2
  },
  {
   "fieldname": "account_id",
   "fieldtype": "Data",
   "label": "Account / Page / Channel ID",
   "reqd": 1,
   "description": "IG: Instagram Business Account ID. FB: Page ID. YouTube: Channel ID (UC...). TikTok: open_id. LinkedIn: URN lengkap, mis. urn:li:organization:12345 atau urn:li:person:AbC123."
  },
  {
   "fieldname": "enabled",
   "fieldtype": "Check",
   "label": "Enabled",
   "read_only": 1,
   "in_list_view": 1,
   "columns": 1,
   "no_copy": 1,
   "description": "Aktif otomatis hanya setelah Test Connection berhasil. Berubah ke nonaktif jika kredensial diganti."
  },
  {
   "fieldname": "token_expires_on",
   "fieldtype": "Datetime",
   "label": "Token Expires On",
   "in_list_view": 1,
   "columns": 2
  },
  {
   "fieldname": "test_connection",
   "fieldtype": "Button",
   "label": "Test Connection"
  },
  {
   "fieldname": "connection_status",
