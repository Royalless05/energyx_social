   "description": "YouTube (wajib), TikTok dan LinkedIn (opsional; LinkedIn hanya bila app Anda disetujui untuk refresh token)."
  },
  {
   "fieldname": "options_section",
   "fieldtype": "Section Break",
   "label": "Options"
  },
  {
   "fieldname": "api_version",
   "fieldtype": "Data",
   "label": "Api Version",
