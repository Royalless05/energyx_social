   "depends_on": "eval:[\"Instagram\",\"Facebook Page\",\"LinkedIn\"].includes(doc.channel)",
   "description": "Meta: host+versi, mis. graph.facebook.com/v21.0. LinkedIn: versi API format YYYYMM, mis. 202610 (kosong = bawaan)."
  },
  {
   "fieldname": "playlist_id",
   "fieldtype": "Data",
